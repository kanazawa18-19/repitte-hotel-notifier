# Slack Bot Token (xoxb-...)
SLACK_BOT_TOKEN=xoxb-xxxxxxxxxxxx

# Slack App Token for Socket Mode (xapp-...)
SLACK_APP_TOKEN=xapp-xxxxxxxxxxxx

# チャンネルID（Slackでチャンネル名を右クリック → コピー → チャンネルIDをコピー）
JOB_SALES_CHANNEL_ID=C000000001
REPITTE_HOTEL_CHANNEL_ID=C000000002

# ユーザーID（Slackでプロフィール → ⋮ → メンバーIDをコピー）
HIRAMOTO_USER_ID=U000000001
TAKESUE_USER_ID=U000000002

# ユーザーグループID（Slack管理画面 > ユーザーグループ > @repitte_team のURLに含まれるID）
REPITTE_TEAM_GROUP_ID=S000000001
